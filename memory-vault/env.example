# Copy to .env (never commit it). Loaded automatically by npm start.
PORT=3000
HOST=127.0.0.1
# Set both when served over HTTPS behind Caddy/nginx:
# COOKIE_SECURE=1
# TRUST_PROXY=1

# Where the original photos/videos live: r2 (Cloudflare R2) or local (this machine's disk)
STORAGE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: R2_ENDPOINT=https://<account>.eu.r2.cloudflarestorage.com   (EU jurisdiction buckets)
