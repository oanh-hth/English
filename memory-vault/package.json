{
  "name": "memory-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private, login-protected vault for original-quality photos/videos with notes.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
