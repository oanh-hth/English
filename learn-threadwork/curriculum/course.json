{
  "phases": [
    {
      "id": "0",
      "folder": "phase-0-setup",
      "title": "Setup and your first test",
      "goal": "Install the tools, run the app, and make your first test pass."
    },
    {
      "id": "1",
      "folder": "phase-1-typescript",
      "title": "TypeScript through the task model",
      "goal": "Types, unions, type guards, immutable updates, generics and validating unknown data."
    },
    {
      "id": "2",
      "folder": "phase-2-domain-logic",
      "title": "Domain logic: dates, garden and rewards",
      "goal": "Pure functions and reducers for streaks, plant growth, harvests, treats and badges."
    },
    {
      "id": "3",
      "folder": "phase-3-react-components",
      "title": "React components",
      "goal": "JSX, props, state, events, lists, forms and accessible markup, tested like a user would use them."
    },
    {
      "id": "4",
      "folder": "phase-4-state-and-hooks",
      "title": "State management and hooks",
      "goal": "Custom hooks, useReducer, Context, effects and timers."
    },
    {
      "id": "5",
      "folder": "phase-5-graphics-and-pencil",
      "title": "Graphics and Apple Pencil",
      "goal": "SVG from data, stroke geometry and pointer events with palm rejection."
    },
    {
      "id": "6",
      "folder": "phase-6-node-server",
      "title": "Node.js server with Express",
      "goal": "HTTP, routing, REST, validation, password hashing, tokens, files and calling other APIs."
    },
    {
      "id": "7",
      "folder": "phase-7-full-stack",
      "title": "Full stack: connect the app to the server",
      "goal": "A typed API client, sync decisions and an async login form."
    }
  ],
